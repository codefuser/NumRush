# ====================================================================
# NumRush Backend Server Configuration
# ====================================================================

PORT=3001
NODE_ENV=development

# Allowed CORS origins (comma-separated or * for development)
CORS_ORIGIN=*

# Web Application URL (used in generated room invitations)
APP_URL=http://localhost:5173

# Database & Supabase (Optional for dev: server includes automatic in-memory persistent store fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL URL (Alternative to Supabase client)
DATABASE_URL=postgresql://postgres:password@localhost:5432/numrush

# Game Rules
MAX_NUMBER_LIMIT=500
RECONNECTION_GRACE_PERIOD_MS=60000
